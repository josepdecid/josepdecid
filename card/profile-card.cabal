cabal-version:      2.4
name:               profile-card
version:            1.0.0
synopsis:           Generates josepdecid's animated GitHub profile card
description:        Queries the GitHub GraphQL API and renders a neofetch-style
                    terminal card as a pair of light/dark animated SVGs.
author:             Josep de Cid
maintainer:         josep.de.cid@gmail.com
license:            MIT
build-type:         Simple

executable profile-card
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    ProfileCard.Config
                      ProfileCard.GitHub
                      ProfileCard.Stats
                      ProfileCard.Cache
                      ProfileCard.Render
                      ProfileCard.Format
    build-depends:    base              >=4.17 && <5
                    , aeson             >=2.1
                    , aeson-pretty      >=0.8
                    , bytestring        >=0.11
                    , containers        >=0.6
                    , crypton           >=0.34
                    , directory         >=1.3
                    , filepath          >=1.4
                    , http-client       >=0.7
                    , http-client-tls   >=0.3
                    , http-types        >=0.12
                    , text              >=2.0
                    , time              >=1.12
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -O1
